<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>SLH.BurmeseConsole.Templates</PackageId>
    <PackageVersion>1.2.3</PackageVersion>
    <PackageType>Template</PackageType>
    <Authors>Sann Lynn Htun</Authors>
    <Description>Single-project Burmese Console App with Pyidaungsu, inline input and cross-platform Avalonia text rendering.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="templates/**/*" Exclude="templates/**/bin/**;templates/**/obj/**;templates/**/.vs/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
