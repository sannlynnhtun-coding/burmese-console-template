{
  "classifications": [
    "Console",
    "Windows",
    "Linux",
    "macOS",
    "Burmese"
  ],
  "$schema": "http://json.schemastore.org/template",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "replaces": "net10.0",
      "datatype": "choice",
      "description": "Target .NET version",
      "choices": [
        {
          "description": ".NET 6",
          "choice": "net6.0"
        },
        {
          "description": ".NET 7",
          "choice": "net7.0"
        },
        {
          "description": ".NET 8",
          "choice": "net8.0"
        },
        {
          "description": ".NET 9",
          "choice": "net9.0"
        },
        {
          "description": ".NET 10",
          "choice": "net10.0"
        },
        {
          "description": ".NET 11 (Preview; preview SDK required)",
          "choice": "net11.0"
        }
      ],
      "defaultValue": "net10.0"
    }
  },
  "tags": {
    "type": "project",
    "language": "C#"
  },
  "name": "Burmese Console App (Pyidaungsu)",
  "sourceName": "BurmeseApp",
  "author": "Sann Lynn Htun",
  "primaryOutputs": [
    {
      "path": "BurmeseApp.csproj"
    }
  ],
  "sources": [
    {
      "exclude": [
        "**/bin/**",
        "**/obj/**",
        ".template.config/**"
      ]
    }
  ],
  "defaultName": "BurmeseApp",
  "identity": "SLH.BurmeseConsole.Pyidaungsu",
  "shortName": "burmese-console",
  "description": "A single C# project with Burmese Hello World and inline Pyidaungsu console input for Windows, Linux and macOS."
}
